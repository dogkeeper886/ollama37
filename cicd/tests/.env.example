# Copy to .env (gitignored) and fill in. These map 1:1 to the GitHub Actions
# secret names the test-mcp.yml workflow feeds in CI — same names locally and in CI.
TESTLINK_URL=
TESTLINK_API_KEY=
# Keyless agent-judge auth (--judge / --verify-live). Optional: falls back to ~/.claude.
CLAUDE_CODE_OAUTH_TOKEN=
# any container name; default ollama37
OLLAMA37_CONTAINER=
# http://<host>:<port>; default http://localhost:11434
OLLAMA_HOST=
# comma-separated testcase IDs (TC-MODELS-003,TC-MODELS-004); unset = every test
OLLAMA37_TEST_IDS=
