# A self-hosted runner's .env (#542): copy to <runner folder>/.env and restart the
# runner service (it reads .env only at start). Each host names its own server
# under test and model lists here, so the workflows stay the same on every card.
# sm37 (Tesla K80) is the reference host; sm61/sm86 list only what fits one card.

# Compose files for the CI container, and the shared model store it mounts.
COMPOSE_FILE=docker-compose.yml:docker-compose.ci.yml
OLLAMA37_MODELS_DIR=/home/jack/.ollama/models

# GPU hand-over (cicd/scripts/gpu-yield.sh, gpu-restore.sh): the user systemd unit
# that serves the build under test, and the one that normally holds the card.
# Unset = touch nothing; test whatever serves OLLAMA_HOST.
OLLAMA37_SERVICE=ollama37
OLLAMA37_YIELD_SERVICE=ollama

# Container name (deploy.sh, VRAM attribution). Default ollama37.
#OLLAMA37_CONTAINER=ollama37
# Server under test. Default http://localhost:11434.
#OLLAMA_HOST=http://localhost:11434

# Model lists, used when a run gives no --models. Space-separated tags.
OLLAMA37_MODELS=deepseek-r1:1.5b deepseek-r1:8b gemma3:270m gemma3:27b gemma3n:e2b gemma4:12b gemma4:31b gemma4:e2b gpt-oss:20b lfm2.5:8b lfm2.5-thinking:1.2b llama3.1:8b ministral-3:3b ornith:35b ornith-1.5:9b ornith-1.5:35b qwen3.5:9b qwen3.6:35b qwen3.8:27b qwen3-vl:2b qwen3-vl:30b
OLLAMA37_THROUGHPUT_MODELS=deepseek-r1:1.5b deepseek-r1:8b gemma3:270m gemma3:27b gemma3:4b gemma3n:e2b gemma4:12b gemma4:26b gemma4:31b gemma4:e2b gpt-oss:20b lfm2.5-thinking:1.2b lfm2.5:8b llama3.1:8b ministral-3:3b ornith:35b qwen3-vl:2b qwen3-vl:30b qwen3.5:9b qwen3.6:27b qwen3.6:35b qwen3.8:27b
# The MCP test needs native tool support.
OLLAMA37_MCP_MODELS=qwen3.8:27b

# The MCP server under test (mcp.ts). Defaults: testlink-mcp in docker, with
# TESTLINK_URL and TESTLINK_API_KEY forwarded (those come from repository secrets).
#MCP_COMMAND=docker
#MCP_ARGS=run --rm -i -e TESTLINK_URL -e TESTLINK_API_KEY dogkeeper886/testlink-mcp:latest
#MCP_ENV=TESTLINK_URL,TESTLINK_API_KEY

# The judge (JUDGE_BASE_URL, JUDGE_MODEL) and OLLAMA_VERSION are not set here:
# they are variables of the cicd-1 GitHub environment, passed in by the workflows.
