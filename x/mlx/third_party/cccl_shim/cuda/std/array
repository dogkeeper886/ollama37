// K80 port shim: CUDA 11.4 omits the top-level <cuda/std/array> header but DOES
// define cuda::std::array (in a versioned inline namespace) via the libcu++
// detail headers that the other cuda/std includes pull in (tuple/limits/etc.).
// So this header just needs to exist and ensure that definition is available —
// it must NOT define its own cuda::std::array (that collides with the real one:
// "cuda::std::array is ambiguous"). Pull in <cuda/std/tuple>, which transitively
// makes the real definition visible.
#pragma once
#include <cuda/std/tuple>
